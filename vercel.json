{
  "version": 2,
  "rewrites": [
    {
      "source": "/images/:match*",
      "destination": "/public/images/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}